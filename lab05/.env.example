# Открытые SSH-ключи стенда, по одной строке на ключ.
# Скопируйте файл в .env и подставьте содержимое соответствующих файлов *.pub из secrets/.

# Jenkins -> ssh-agent (secrets/jenkins_agent_ssh_key.pub).
JENKINS_AGENT_SSH_PUBKEY=ssh-ed25519 AAAA... jenkins-ssh-agent

# Jenkins -> ansible-agent (secrets/jenkins_ansible_agent_key.pub).
JENKINS_ANSIBLE_AGENT_SSH_PUBKEY=ssh-ed25519 AAAA... jenkins-ansible-agent

# ansible-agent -> test-server, пользователь ansible (secrets/ansible_test_server_key.pub).
# Закрытый ключ этой пары хранится только в Jenkins (учётные данные ansible-test-server-key).
ANSIBLE_TEST_SERVER_SSH_PUBKEY=ssh-ed25519 AAAA... ansible-test-server
